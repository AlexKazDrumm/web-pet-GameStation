{
  "name": "gamestation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GameStation — игровой портал с мини-играми, лидербордами, отзывами и перепиской игрок–администратор",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKazDrumm/web-pet-GameStation.git"
  },
  "bugs": {
    "url": "https://github.com/AlexKazDrumm/web-pet-GameStation/issues"
  },
  "homepage": "https://github.com/AlexKazDrumm/web-pet-GameStation#readme",
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @gamestation/shared && npm run build --workspace @gamestation/api && npm run build --workspace @gamestation/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspace @gamestation/shared && npm run test --workspace @gamestation/api && npm run test --workspace @gamestation/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev --workspace @gamestation/api\" \"npm:dev --workspace @gamestation/web\"",
    "db:migrate": "npm run db:migrate --workspace @gamestation/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @gamestation/api",
    "db:seed": "npm run db:seed --workspace @gamestation/api",
    "db:reset": "npm run db:reset --workspace @gamestation/api",
    "e2e": "npm run test --workspace @gamestation/e2e",
    "e2e:install": "npm run install:browsers --workspace @gamestation/e2e",
    "docker:up": "docker compose up --build -d",
    "docker:seed": "docker compose exec api npm run db:seed:prod",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "9.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
