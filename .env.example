# ─────────────────────────────────────────────────────────────
# GameStation — пример переменных окружения.
# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# Файл .env в репозиторий не попадает.
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL ---
# Используется контейнером базы и строкой подключения API.
POSTGRES_USER=gamestation
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=gamestation

# Строка подключения для API.
# Локальный запуск (npm run dev):        localhost:5432
# Запуск через docker compose:           host = db
DATABASE_URL=postgresql://gamestation:change-me-postgres@localhost:5432/gamestation

# --- API ---
NODE_ENV=development
API_PORT=4000

# Секрет подписи JWT. Не короче 32 символов. Задайте случайное значение,
# например:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES_IN=24h

# Стоимость bcrypt (число раундов).
BCRYPT_ROUNDS=12

# Разрешённые Origin для CORS (через запятую).
WEB_ORIGIN=http://localhost:5173

# Пароль учётных записей из seed-скрипта (dev-данные).
SEED_PASSWORD=demo-password-123

# --- Web ---
# Базовый URL API для фронтенда.
# Локально можно оставить пустым — Vite проксирует /api на API_PORT.
VITE_API_URL=
